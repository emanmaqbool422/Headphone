<div class="custom-details-faq-section">
  <div class="page-width custom-details-faq-container">
    
    <!-- 1. OVERVIEW SECTION -->
    <div class="custom-df-block" id="custom-product-overview-text">
      <div class="custom-df-left">
        <h2 class="custom-df-heading">OVERVIEW</h2>
      </div>
      <div class="custom-df-right">
        <p class="custom-df-overview-text">
          Meet RAP, the wireless headphones that deliver rich sound, lasting comfort, and effortless connectivity for your daily routine. Equipped with 40mm dynamic drivers, RAP produces balanced, immersive audio whether you're listening to music, watching movies, or taking calls. With Bluetooth 6.0 and Dual Device Connectivity, switching between your phone and laptop is seamless. A 400mAh battery provides up to 15 hours of playtime, while USB Type-C charging gets you back to your music with ease. Lightweight, comfortable, and built for everyday use, RAP is designed to keep your soundtrack going wherever life takes you.
        </p>
      </div>
    </div>

    <div class="custom-df-divider"></div>

    <!-- 2. TECHNICAL SPECS SECTION -->
    <div id="custom-product-specs" class="custom-df-block">
      <div class="custom-df-left">
        <h2 class="custom-df-heading">Technical Specs</h2>
      </div>
      <div class="custom-df-right">
        <div class="custom-specs-list">
          <div class="custom-spec-row">
            <span class="custom-spec-name">Name</span>
            <span class="custom-spec-val">RAP</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Model</span>
            <span class="custom-spec-val">R-1525</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Bluetooth Version</span>
            <span class="custom-spec-val">Bluetooth 6.0</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Driver Size</span>
            <span class="custom-spec-val">40mm Dynamic Drivers</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Battery Capacity</span>
            <span class="custom-spec-val">400mAh</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Playtime</span>
            <span class="custom-spec-val">Up to 15 Hours</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Charging Time</span>
            <span class="custom-spec-val">About 2.5 Hours</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Charging Port</span>
            <span class="custom-spec-val">USB Type-C</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Dual Device Connectivity</span>
            <span class="custom-spec-val">Yes</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Stereo Sound</span>
            <span class="custom-spec-val">Yes</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Bluetooth Profiles</span>
            <span class="custom-spec-val">HFP, A2DP, AVRCP</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Operating Range</span>
            <span class="custom-spec-val">Up to 10 Meters</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Frequency Response</span>
            <span class="custom-spec-val">20Hz-20kHz</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Standby Time</span>
            <span class="custom-spec-val">Up to 300 Hours</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">Water Resistance</span>
            <span class="custom-spec-val">No</span>
          </div>
          <div class="custom-spec-row">
            <span class="custom-spec-name">In - Built Microphone</span>
            <span class="custom-spec-val">Yes</span>
          </div>
        </div>
      </div>
    </div>

    <div class="custom-df-divider"></div>

    <!-- 3. FREQUENTLY ASKED QUESTIONS SECTION -->
    <div id="custom-product-faq" class="custom-df-block">
      <div class="custom-df-left">
        <h2 class="custom-df-heading">Frequently<br>asked questions</h2>
      </div>
      <div class="custom-df-right">
        <div class="custom-faq-accordion">
          
          <details class="custom-faq-item">
            <summary class="custom-faq-summary">
              <span>1. How long does the RAP battery last?</span>
              <svg class="custom-faq-icon" width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="custom-faq-answer">
              <p>The RAP battery provides up to 15 hours of continuous playtime on a single full charge, with up to 300 hours of standby time.</p>
            </div>
          </details>

          <details class="custom-faq-item">
            <summary class="custom-faq-summary">
              <span>2. Can RAP connect to two devices at once?</span>
              <svg class="custom-faq-icon" width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="custom-faq-answer">
              <p>Yes, RAP features Dual Device Connectivity, allowing you to seamlessly switch audio between your smartphone and laptop without re-pairing.</p>
            </div>
          </details>

          <details class="custom-faq-item">
            <summary class="custom-faq-summary">
              <span>3. What type of charging port does RAP use?</span>
              <svg class="custom-faq-icon" width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="custom-faq-answer">
              <p>RAP uses a standard USB Type-C charging port for quick, easy, and reliable charging.</p>
            </div>
          </details>

          <details class="custom-faq-item">
            <summary class="custom-faq-summary">
              <span>4. What size drivers does RAP have?</span>
              <svg class="custom-faq-icon" width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="custom-faq-answer">
              <p>RAP is equipped with custom-tuned 40mm Dynamic Drivers that produce deep bass, clear mids, and crisp highs.</p>
            </div>
          </details>

          <details class="custom-faq-item">
            <summary class="custom-faq-summary">
              <span>5. What devices are compatible with RAP?</span>
              <svg class="custom-faq-icon" width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="custom-faq-answer">
              <p>RAP is compatible with all Bluetooth-enabled devices including iPhone, Android phones, tablets, MacBooks, Windows PCs, and smart TVs.</p>
            </div>
          </details>

        </div>
      </div>
    </div>

    <div class="custom-df-divider"></div>

    <!-- 4. CUSTOMER REVIEWS SECTION -->
    <div id="custom-product-reviews" class="custom-df-block">
      <div class="custom-df-left">
        <h2 class="custom-df-heading">Customer<br>Reviews</h2>
      </div>
      <div class="custom-df-right">
        <div class="custom-reviews-summary">
          <div class="custom-reviews-score">
            <span class="custom-reviews-big-score">4.8</span>
            <div class="custom-reviews-stars">★★★★★</div>
            <span class="custom-reviews-count">Based on 14 reviews</span>
          </div>
          <div class="custom-reviews-list">
            <div class="custom-review-card">
              <div class="custom-review-header">
                <span class="custom-review-author">Ali R.</span>
                <span class="custom-review-stars">★★★★★</span>
              </div>
              <p class="custom-review-body">Sound quality is incredible for the price. Deep bass, very comfortable for long sessions, and battery easily lasts all day!</p>
            </div>
            <div class="custom-review-card">
              <div class="custom-review-header">
                <span class="custom-review-author">Hamza K.</span>
                <span class="custom-review-stars">★★★★★</span>
              </div>
              <p class="custom-review-body">Dual device pairing works like a charm. Build quality feels very premium. Highly recommended.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .custom-details-faq-section {
    background-color: #f7f7f7;
    padding: 5rem 0;
    width: 100%;
    color: #2b2b2b;
    font-family: inherit;
  }

  .custom-details-faq-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .custom-df-block {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 3rem 0;
  }

  @media screen and (min-width: 768px) {
    .custom-df-block {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 3.5rem;
    }
  }

  .custom-df-left {
    display: flex;
    align-items: flex-start;
  }

  .custom-df-heading {
    font-size: 2.1rem;
    font-weight: 700;
    line-height: 1.25;
    color: #1f2937;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .custom-df-right {
    width: 100%;
  }

  .custom-df-overview-text {
    font-size: 1.44rem;
    line-height: 1.8;
    color: #374151;
    margin: 0;
  }

  .custom-df-divider {
    height: 1px;
    background-color: #e2e2e2;
    width: 100%;
  }

  /* Tech Specs Table List */
  .custom-specs-list {
    display: flex;
    flex-direction: column;
  }

  .custom-spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.05rem 0;
    border-bottom: 1px solid #e2e2e2;
    font-size: 1.08rem;
  }

  .custom-spec-row:last-child {
    border-bottom: none;
  }

  .custom-spec-name {
    font-size: 1.44rem;
    font-weight: 600;
    color: #1f2937;
  }

  .custom-spec-val {
    font-size: 1.44rem;
    color: #4b5563;
    text-align: right;
  }

  /* FAQ Accordion */
  .custom-faq-accordion {
    display: flex;
    flex-direction: column;
  }

  .custom-faq-item {
    border-bottom: 1px solid #e2e2e2;
    padding: 0.2rem 0;
  }

  .custom-faq-item:last-child {
    border-bottom: none;
  }

  .custom-faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    font-size: 1.44rem;
    font-weight: 600;
    color: #1f2937;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .custom-faq-summary::-webkit-details-marker {
    display: none;
  }

  .custom-faq-icon {
    transition: transform 0.3s ease;
    color: #4b5563;
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .custom-faq-item[open] .custom-faq-icon {
    transform: rotate(180deg);
  }

  .custom-faq-answer {
    padding: 0 0 1.2rem 0;
    font-size: 1.44rem;
    line-height: 1.7;
    color: #374151;
  }

  .custom-faq-answer p {
    margin: 0;
  }

  /* Customer Reviews Styling */
  .custom-reviews-summary {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .custom-reviews-score {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e2e2;
  }

  .custom-reviews-big-score {
    font-size: 2.4rem;
    font-weight: 700;
    color: #111827;
  }

  .custom-reviews-stars {
    color: #f59e0b;
    font-size: 1.44rem;
    letter-spacing: 2px;
  }

  .custom-reviews-count {
    color: #6b7280;
    font-size: 1.44rem;
  }

  .custom-reviews-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  @media screen and (min-width: 640px) {
    .custom-reviews-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .custom-review-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.35rem;
  }

  .custom-review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .custom-review-author {
    font-weight: 600;
    color: #1f2937;
    font-size: 1.44rem;
  }

  .custom-review-body {
    margin: 0;
    color: #374151;
    font-size: 1.44rem;
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Overview Specs & FAQ",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Overview Specs & FAQ"
    }
  ]
}
{% endschema %}
