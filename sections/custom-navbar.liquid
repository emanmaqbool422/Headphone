{% comment %}
  Single Reusable Floating Pill Navbar Component
{% endcomment %}

<div class="custom-navbar-wrapper">
  <nav class="custom-navbar" aria-label="Main Navigation">
    <!-- Left: Logo Slot -->
    <div id="logo-slot" class="navbar-logo-slot">
      <a href="/" aria-label="RONIN Home">
        <img 
          src="{{ 'Ronin_Logo_White.avif' | asset_url }}" 
          alt="RONIN Logo" 
          class="logo-placeholder-img"
          height="32"
          loading="eager"
        >
      </a>
    </div>

    <!-- Center Menu (Desktop) -->
    <div class="navbar-center-menu">
    </div>

    <!-- Right Side: Search & Order Track Button -->
    <div class="navbar-right-side">
      <!-- Search Component -->
      <div class="navbar-search-wrapper" id="navbarSearchWrapper">
        <button type="button" class="navbar-btn-icon" id="navbarSearchToggle" aria-label="Toggle search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7.5"></circle>
            <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
          </svg>
        </button>

        <form action="/search" method="get" class="navbar-search-form" id="navbarSearchForm" role="search">
          <input type="search" name="q" class="navbar-search-input" id="navbarSearchInput" placeholder="Search..." autocomplete="off">
          <button type="button" class="navbar-search-close" id="navbarSearchClose" aria-label="Close search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </form>
      </div>


      <!-- Add to Cart Icon Button -->
      <a href="/cart" class="navbar-btn-icon navbar-cart-btn" aria-label="Cart" id="navbarCartBtn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="navbar-cart-count{% if cart.item_count == 0 %} is-hidden{% endif %}" id="navbarCartCount" aria-label="{{ cart.item_count }} items">
          {{ cart.item_count }}
        </span>
      </a>

      <!-- Checkout Icon Button -->
      <a href="/checkout" class="navbar-btn-icon" aria-label="Checkout" id="navbarCheckoutBtn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
          <line x1="1" y1="10" x2="23" y2="10"></line>
        </svg>
      </a>


      <!-- Mobile Hamburger Button -->
      <button type="button" class="navbar-btn-icon navbar-hamburger-btn" id="navbarMobileToggle" aria-label="Toggle navigation">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu -->
  <div class="navbar-mobile-menu" id="navbarMobileMenu" aria-hidden="true">
  </div>
</div>

<style>
  /* Floating Pill Navbar Container */
  .custom-navbar-wrapper {
    position: sticky;
    top: 14px;
    z-index: 999;
    width: 100%;
    max-width: min(var(--page-width, 1200px), 94%);
    margin: 0 auto 1.5rem auto;
    box-sizing: border-box;
  }

  .custom-navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 58px;
    padding: 0 20px;
    background: rgba(217, 217, 217, 0.85);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border: none;
    border-radius: 50px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    font-family: var(--font-body-family, sans-serif);
    transition: all 0.25s ease;
  }

  /* Left Logo Slot */
  #logo-slot {
    display: flex;
    align-items: center;
    max-height: 40px;
    flex-shrink: 0;
  }

  #logo-slot a {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-placeholder-img {
    height: 32px;
    max-height: 32px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  /* Center Menu */
  .navbar-center-menu {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .navbar-menu-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 9999px;
    text-decoration: none;
    color: rgb(var(--color-foreground, 18, 18, 18));
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .navbar-menu-item .navbar-icon {
    stroke: currentColor;
    opacity: 0.85;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .navbar-menu-item:hover {
    background: rgba(var(--color-foreground, 18, 18, 18), 0.06);
    transform: translateY(-1.5px);
  }

  .navbar-menu-item:hover .navbar-icon {
    opacity: 1;
    transform: scale(1.08);
  }

  /* Right Side Controls */
  .navbar-right-side {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Search Component & Padding/Margin Fixes */
  .navbar-search-wrapper {
    display: flex;
    align-items: center;
    position: relative;
  }

  .navbar-btn-icon {
    background: transparent;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
    position: relative;
    text-decoration: none;
  }

  .navbar-cart-btn {
    position: relative;
  }

  .navbar-cart-count {
    position: absolute;
    top: -2px;
    right: -3px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9999px;
    background: #111827;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    pointer-events: none;
    box-sizing: border-box;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
  }

  .navbar-cart-count.is-hidden {
    display: none !important;
  }

  @keyframes cartCountPop {
    0% { transform: scale(0.6); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  .navbar-cart-count.has-bounce {
    animation: cartCountPop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .navbar-btn-icon svg {
    stroke: #FFFFFF;
  }

  .navbar-btn-icon:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: translateY(-1px);
  }

  .navbar-search-form {
    display: flex;
    align-items: center;
    width: 0;
    height: 38px;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease, margin 0.25s ease, padding 0.25s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    background: rgba(var(--color-background, 255, 255, 255), 0.96);
    border: 1px solid rgba(var(--color-foreground, 18, 18, 18), 0.18);
    border-radius: 9999px;
    padding: 0;
    margin-left: 0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
    outline: none !important;
  }

  .navbar-search-wrapper.is-expanded .navbar-search-form {
    width: 280px;
    opacity: 1;
    pointer-events: auto;
    margin-left: 8px;
    margin-right: 4px;
    padding: 0 12px 0 16px;
  }

  .navbar-search-form:focus-within {
    border-color: rgba(var(--color-foreground, 18, 18, 18), 0.35);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.09);
    outline: none !important;
  }

  .navbar-search-input {
    background: transparent;
    border: none !important;
    outline: none !important;
    outline-offset: 0 !important;
    box-shadow: none !important;
    color: rgb(var(--color-foreground, 18, 18, 18));
    font-size: 14px;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    font-family: inherit;
    -webkit-appearance: none;
    appearance: none;
  }

  .navbar-search-input:focus,
  .navbar-search-input:focus-visible,
  .navbar-search-input.focused,
  .navbar-search-input:active {
    border: none !important;
    outline: none !important;
    outline-offset: 0 !important;
    box-shadow: none !important;
  }

  .navbar-search-input::-webkit-search-decoration,
  .navbar-search-input::-webkit-search-cancel-button,
  .navbar-search-input::-webkit-search-results-button,
  .navbar-search-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    display: none;
  }

  .navbar-search-input::placeholder {
    color: rgba(var(--color-foreground, 18, 18, 18), 0.55);
    font-size: 14px;
  }

  .navbar-search-close {
    background: transparent;
    border: none !important;
    outline: none !important;
    outline-offset: 0 !important;
    box-shadow: none !important;
    color: rgb(var(--color-foreground, 18, 18, 18));
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    margin-left: 6px;
    opacity: 0.65;
    transition: opacity 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .navbar-search-close:focus,
  .navbar-search-close:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }

  .navbar-search-close:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .navbar-btn-icon:focus,
  .navbar-btn-icon:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }

  /* Darker Order Track Pill Button */
  .navbar-order-track-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    height: 36px;
    background: rgb(var(--color-button, 18, 18, 18));
    color: rgb(var(--color-button-text, 255, 255, 255));
    border-radius: 9999px;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(var(--color-button, 18, 18, 18), 0.2);
    transition: all 0.2s ease;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .navbar-order-track-btn:hover {
    opacity: 0.92;
    transform: translateY(-1.5px);
    box-shadow: 0 4px 12px rgba(var(--color-button, 18, 18, 18), 0.3);
  }

  /* Mobile Hamburger */
  .navbar-hamburger-btn {
    display: none;
  }

  /* Mobile Dropdown */
  .navbar-mobile-menu {
    display: none;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
    padding: 12px;
    background: rgba(var(--color-background, 255, 255, 255), 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(var(--color-foreground, 18, 18, 18), 0.12);
    border-radius: 18px;
    box-shadow: 0 12px 28px rgba(var(--color-foreground, 18, 18, 18), 0.12);
  }

  .navbar-mobile-menu.is-active {
    display: flex;
    animation: navFadeDown 0.25s ease forwards;
  }

  .navbar-mobile-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 10px;
    text-decoration: none;
    color: rgb(var(--color-foreground, 18, 18, 18));
    font-weight: 500;
    font-size: 14px;
    transition: background 0.15s ease;
  }

  .navbar-mobile-item:hover {
    background: rgba(var(--color-foreground, 18, 18, 18), 0.06);
  }

  @keyframes navFadeDown {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive Breakpoints */
  @media (max-width: 868px) {
    .navbar-center-menu {
      display: none;
    }

    .navbar-hamburger-btn {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .order-track-text {
      display: none;
    }

    .navbar-order-track-btn {
      padding: 7px 12px;
    }
    
    .custom-navbar {
      padding: 0 14px;
    }

    .navbar-search-wrapper.is-expanded .navbar-search-form {
      width: 175px;
      height: 36px;
      padding: 0 10px 0 12px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchToggle = document.getElementById('navbarSearchToggle');
    const searchWrapper = document.getElementById('navbarSearchWrapper');
    const searchClose = document.getElementById('navbarSearchClose');
    const searchInput = document.getElementById('navbarSearchInput');

    if (searchToggle && searchWrapper) {
      searchToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        searchWrapper.classList.toggle('is-expanded');
        if (searchWrapper.classList.contains('is-expanded')) {
          setTimeout(() => searchInput && searchInput.focus(), 120);
        }
      });
    }

    if (searchClose && searchWrapper) {
      searchClose.addEventListener('click', function(e) {
        e.stopPropagation();
        searchWrapper.classList.remove('is-expanded');
      });
    }

    document.addEventListener('click', function(e) {
      if (searchWrapper && !searchWrapper.contains(e.target)) {
        searchWrapper.classList.remove('is-expanded');
      }
    });

    const mobileToggle = document.getElementById('navbarMobileToggle');
    const mobileMenu = document.getElementById('navbarMobileMenu');

    if (mobileToggle && mobileMenu) {
      mobileToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        const active = mobileMenu.classList.toggle('is-active');
        mobileMenu.setAttribute('aria-hidden', !active);
      });
    }

    // Dynamic cart count updater
    function updateNavbarCartCount(newCount) {
      const cartCountEl = document.getElementById('navbarCartCount');
      if (!cartCountEl) return;

      function renderCount(count) {
        cartCountEl.textContent = count;
        if (count > 0) {
          cartCountEl.classList.remove('is-hidden');
          cartCountEl.style.display = 'flex';
          cartCountEl.classList.remove('has-bounce');
          void cartCountEl.offsetWidth;
          cartCountEl.classList.add('has-bounce');
        } else {
          cartCountEl.classList.add('is-hidden');
          cartCountEl.style.display = 'none';
        }
      }

      if (typeof newCount === 'number') {
        renderCount(newCount);
        return;
      }

      fetch('/cart.js')
        .then(res => res.json())
        .then(cart => {
          renderCount(cart.item_count);
        })
        .catch(err => console.error('Cart count fetch failed:', err));
    }

    window.updateNavbarCartCount = updateNavbarCartCount;

    document.addEventListener('cart:updated', function() {
      updateNavbarCartCount();
    });

    if (typeof subscribe !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined' && PUB_SUB_EVENTS.cartUpdate) {
      subscribe(PUB_SUB_EVENTS.cartUpdate, function() {
        updateNavbarCartCount();
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Navbar",
  "tag": "header",
  "class": "section-custom-navbar",
  "settings": []
}
{% endschema %}
